{
  "$comment": "Character build config for tools/asset-pipeline/build-character.mjs (--config). The retarget section drives tools/level-authoring/character.py; the clips section renames the library's clips to the engine's names. Bone names here must agree with apps/showcase/src/actors/rig.ts.",
  "name": "operator",
  "source": "Quaternius Cyberpunk Game Kit character + Universal Animation Library clips (CC0)",
  "budget": "enemy",
  "publicDir": "apps/showcase/public/models",
  "rootBone": "Root",
  "retarget": {
    "library": "assets/source/characters/ual/AnimationLibrary_Godot_Standard.gltf",
    "target": "assets/source/characters/cyberpunk/SK_Character.usda",
    "out": "assets/source/characters/cyberpunk/retargeted",
    "targetHeight": 1.8,
    "hips": "Body",
    "sourceHips": "DEF-hips",
    "dropMaterials": ["Blade", "Blade_Edge"],
    "footstepClips": ["Walk_Loop", "Walk_Formal_Loop", "Jog_Fwd_Loop", "Sprint_Loop", "Crouch_Fwd_Loop", "Jump_Land"],
    "footContactBand": 0.04,
    "reparent": { "Foot_L": "LowerLeg_L", "Foot_R": "LowerLeg_R" },
    "bones": {
      "Body": { "from": "DEF-hips" },
      "Abdomen": { "from": "DEF-spine.001" },
      "Torso": { "from": "DEF-spine.002" },
      "Chest": { "from": "DEF-spine.003" },
      "Neck": { "from": "DEF-neck" },
      "Head": { "from": "DEF-head" },
      "Shoulder_L": { "from": "DEF-shoulder.L" },
      "UpperArm_L": { "from": "DEF-upper_arm.L", "align": true },
      "LowerArm_L": { "from": "DEF-forearm.L", "align": true },
      "Hand_L": { "from": "DEF-hand.L", "align": true },
      "Shoulder_R": { "from": "DEF-shoulder.R" },
      "UpperArm_R": { "from": "DEF-upper_arm.R", "align": true },
      "LowerArm_R": { "from": "DEF-forearm.R", "align": true },
      "Hand_R": { "from": "DEF-hand.R", "align": true },
      "UpperLeg_L": { "from": "DEF-thigh.L", "align": true },
      "LowerLeg_L": { "from": "DEF-shin.L", "align": true },
      "UpperLeg_R": { "from": "DEF-thigh.R", "align": true },
      "LowerLeg_R": { "from": "DEF-shin.R", "align": true },
      "Foot_L": { "from": "DEF-foot.L" },
      "Foot_R": { "from": "DEF-foot.R" }
    }
  },
  "clips": {
    "idle": { "from": "Idle_Loop", "loop": true },
    "walk": { "from": "Walk_Loop", "loop": true },
    "run": { "from": "Jog_Fwd_Loop", "loop": true },
    "sprint": { "from": "Sprint_Loop", "loop": true },
    "crouch_idle": { "from": "Crouch_Idle_Loop", "loop": true },
    "crouch_walk": { "from": "Crouch_Fwd_Loop", "loop": true },
    "ready": { "from": "Pistol_Idle_Loop", "loop": true },
    "aim_up": { "from": "Pistol_Aim_Up", "loop": true },
    "aim": { "from": "Pistol_Aim_Neutral", "loop": true },
    "aim_down": { "from": "Pistol_Aim_Down", "loop": true },
    "reload": { "from": "Pistol_Reload", "loop": false },
    "hit": { "from": "Hit_Chest", "loop": false },
    "hit_head": { "from": "Hit_Head", "loop": false },
    "death": { "from": "Death01", "loop": false },
    "jump": { "from": "Jump_Loop", "loop": true },
    "land": { "from": "Jump_Land", "loop": false }
  }
}
